      "routeKeys": {},
      "namedRegex": "^/flight(?:/)?$"
    },
    {
      "page": "/future-tasks",
      "regex": "^/future\\-tasks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/future\\-tasks(?:/)?$"
    },
    {
      "page": "/hierarchy",
      "regex": "^/hierarchy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/hierarchy(?:/)?$"
    },
    {
      "page": "/ideas",
      "regex": "^/ideas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ideas(?:/)?$"
    },
    {
      "page": "/market",
      "regex": "^/market(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/market(?:/)?$"
    },
    {
      "page": "/new-task",
      "regex": "^/new\\-task(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/new\\-task(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/skills",
      "regex": "^/skills(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skills(?:/)?$"
    },
    {
      "page": "/skills/heartbeat",
      "regex": "^/skills/heartbeat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skills/heartbeat(?:/)?$"
    },
    {
      "page": "/skills/memory",
      "regex": "^/skills/memory(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skills/memory(?:/)?$"
    },
    {
      "page": "/skills/soul",
      "regex": "^/skills/soul(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skills/soul(?:/)?$"
    },
    {
      "page": "/social-posts",
      "regex": "^/social\\-posts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/social\\-posts(?:/)?$"
    },
    {
      "page": "/tasks-in-progress",
      "regex": "^/tasks\\-in\\-progress(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tasks\\-in\\-progress(?:/)?$"
    },
    {
      "page": "/tools",
      "regex": "^/tools(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tools(?:/)?$"
