{
  "version": 3,
  "pages404": true,
  "appType": "pages",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/activity",
      "regex": "^/activity(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/activity(?:/)?$"
    },
    {
      "page": "/completed",
      "regex": "^/completed(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/completed(?:/)?$"
    },
    {
      "page": "/flight",
